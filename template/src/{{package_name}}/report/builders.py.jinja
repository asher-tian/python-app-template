"""Business-owned report builders and artifact layouts."""

from __future__ import annotations

from html import escape
from pathlib import PurePosixPath

from {{ package_name }}.core.workflows.analysis import AnalysisResult
from {{ package_name }}.core.workflows.comparison import ComparisonResult
from {{ package_name }}.report.models import DatasetReference, GroupRunResult
from {{ package_name }}.store.files import write_json, write_jsonl, write_text
from {{ package_name }}.store.workspace import Workspace


def _configured_path(paths: dict[str, str], key: str, *parts: str) -> str:
    try:
        base = paths[key]
    except KeyError as exc:
        raise ValueError(f"Business configuration is missing paths.{key}") from exc
    return PurePosixPath(base, *parts).as_posix()


def _report_page(
    *,
    title: str,
    business_id: str,
    group_id: str,
    run_id: str,
    report_kind: str,
) -> str:
    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{escape(title)}</title>
  <link rel="stylesheet" href="/assets/vendor/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/app.css">
  <script type="module" src="/assets/js/app.js"></script>
</head>
<body>
  <nav class="navbar app-navbar">
    <div class="container-xxl">
      <a class="navbar-brand" href="/">Report Home</a>
    </div>
  </nav>
  <main id="app" class="container-xxl py-4" data-page="report"
        data-business-id="{escape(business_id)}"
        data-group-id="{escape(group_id)}"
        data-run-id="{escape(run_id)}"
        data-report-kind="{escape(report_kind)}">
    <p class="text-secondary">Loading report…</p>
  </main>
</body>
</html>
"""


def build_analysis_report(
    *,
    workspace: Workspace,
    business_paths: dict[str, str],
    business_id: str,
    group_id: str,
    label: str,
    run_id: str,
    result: AnalysisResult,
) -> GroupRunResult:
    records_path = _configured_path(
        business_paths, "datasets", group_id, run_id, "records.jsonl"
    )
    summary_path = _configured_path(
        business_paths, "datasets", group_id, run_id, "summary.json"
    )
    report_path = _configured_path(
        business_paths, "reports", group_id, run_id, "index.html"
    )

    summary = {
        "item_count": result.item_count,
        "threshold": result.threshold,
        "total": result.total,
    }
    write_jsonl(workspace.root, records_path, result.records)
    write_json(workspace.root, summary_path, summary)
    write_text(
        workspace.root,
        report_path,
        _report_page(
            title=f"Analysis - {label}",
            business_id=business_id,
            group_id=group_id,
            run_id=run_id,
            report_kind="analysis",
        ),
    )
    return GroupRunResult(
        group_id=group_id,
        label=label,
        status="success",
        report_entry=report_path,
        report_kind="analysis",
        datasets=[
            DatasetReference(
                id="records",
                title="Analysis records",
                path=records_path,
                format="jsonl",
                row_count=len(result.records),
            ),
            DatasetReference(id="summary", title="Summary", path=summary_path),
        ],
        summary=summary,
    )


def build_analysis_reanalysis_report(
    *,
    workspace: Workspace,
    business_paths: dict[str, str],
    business_id: str,
    group_id: str,
    label: str,
    run_id: str,
    records: list[dict[str, int]],
    result: dict[str, int],
) -> GroupRunResult:
    records_path = _configured_path(
        business_paths, "derived", group_id, run_id, "records.jsonl"
    )
    result_path = _configured_path(
        business_paths, "derived", group_id, run_id, "reanalysis.json"
    )
    report_path = _configured_path(
        business_paths, "reports", group_id, run_id, "index.html"
    )
    write_jsonl(workspace.root, records_path, records)
    write_json(workspace.root, result_path, result)
    write_text(
        workspace.root,
        report_path,
        _report_page(
            title=f"Analysis - {label}",
            business_id=business_id,
            group_id=group_id,
            run_id=run_id,
            report_kind="analysis",
        ),
    )
    return GroupRunResult(
        group_id=group_id,
        label=label,
        status="success",
        report_entry=report_path,
        report_kind="analysis",
        datasets=[
            DatasetReference(
                id="records",
                title="Analysis records",
                path=records_path,
                format="jsonl",
                row_count=len(records),
            ),
            DatasetReference(
                id="reanalysis",
                title="Secondary analysis",
                path=result_path,
            ),
        ],
        summary=result,
    )


