    result: dict[str, int],
) -> GroupRunResult:
    records_path = _configured_path(
        business_paths, "derived", group_id, run_id, "records.json"
    )
    result_path = _configured_path(
        business_paths, "derived", group_id, run_id, "reanalysis.json"
    )
    report_path = _configured_path(
        business_paths, "reports", group_id, run_id, "index.html"
    )
    write_json(workspace.root, records_path, {"records": records})
    write_json(workspace.root, result_path, result)
    write_text(
        workspace.root,
        report_path,
        _report_page(
            title=f"Analysis - {label}",
            business_id=business_id,
            group_id=group_id,
            run_id=run_id,
            report_kind="analysis",
        ),
    )
    return GroupRunResult(
        group_id=group_id,
        label=label,
        status="success",
