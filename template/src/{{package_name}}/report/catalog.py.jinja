"""Discover report resources from explicit Business / Group metadata."""

from __future__ import annotations

import json
from pathlib import Path

from {{ package_name }}.report.models import (
    BusinessManifest,
    GroupManifest,
    GroupReference,
    RunRecord,
)
from {{ package_name }}.store.files import read_json, resolve_relative
from {{ package_name }}.store.workspace import Workspace


class ReportCatalog:
    def __init__(self, workspace: Workspace) -> None:
        self.workspace = workspace

    def list_businesses(self) -> list[BusinessManifest]:
        businesses: list[BusinessManifest] = []
        if not self.workspace.businesses_dir.exists():
            return businesses
        for directory in sorted(self.workspace.businesses_dir.iterdir()):
            manifest_path = directory / "business.json"
            if directory.is_dir() and manifest_path.is_file():
                business = BusinessManifest.model_validate(
                    json.loads(manifest_path.read_text(encoding="utf-8"))
                )
                if business.business_id != directory.name:
                    raise ValueError("Business ID does not match its workspace directory")
                businesses.append(business)
        return businesses

    def business(self, business_id: str) -> BusinessManifest:
        root = self.workspace.business_dir(business_id)
        data = read_json(root, "business.json")
        business = BusinessManifest.model_validate(data)
        if business.business_id != business_id:
            raise ValueError("Business ID does not match its workspace directory")
        return business

    def group_context(
        self,
        business_id: str,
        group_id: str,
    ) -> tuple[Path, BusinessManifest, GroupReference, GroupManifest]:
        root = self.workspace.business_dir(business_id)
        business = self.business(business_id)
        reference = next(
            (item for item in business.groups if item.group_id == group_id),
            None,
        )
        if reference is None:
            raise FileNotFoundError(f"Unknown Group {business_id}/{group_id}")

        group_data = read_json(root, reference.manifest)
        group = GroupManifest.model_validate(group_data)
        if group.business_id != business_id or group.group_id != group_id:
            raise ValueError("Group Manifest identity does not match its Business reference")
        return root, business, reference, group

    @staticmethod
    def latest_run(group: GroupManifest) -> RunRecord:
        if group.latest_run_id is None:
            raise FileNotFoundError("This Group has no successful report yet")
        run = next((item for item in group.runs if item.run_id == group.latest_run_id), None)
        if run is None or run.status != "success":
            raise ValueError("Group latest_run_id does not reference a successful Run")
        return run

    def run(self, group: GroupManifest, run_id: str | None = None) -> RunRecord:
        if run_id is None:
            return self.latest_run(group)
        run = next((item for item in group.runs if item.run_id == run_id), None)
        if run is None or run.status != "success":
            raise FileNotFoundError(f"Successful Run {run_id!r} was not found")
        return run

    def report_path(
        self,
        business_id: str,
        group_id: str,
        run_id: str | None = None,
    ) -> Path:
        root, _, _, group = self.group_context(business_id, group_id)
        run = self.run(group, run_id)
        if run.report is None:
            raise FileNotFoundError("The selected Run has no report entry")
        path = resolve_relative(root, run.report.entry)
        if not path.is_file():
            raise FileNotFoundError("The declared report entry does not exist")
        return path

    def dataset(
        self,
        business_id: str,
        group_id: str,
        dataset_id: str,
        run_id: str | None = None,
    ):
        root, _, _, group = self.group_context(business_id, group_id)
        run = self.run(group, run_id)
        reference = next((item for item in run.datasets if item.id == dataset_id), None)
        if reference is None:
            raise FileNotFoundError(f"Dataset {dataset_id!r} was not declared by the Run")
        if reference.format != "json":
            raise ValueError(f"Unsupported Dataset format: {reference.format}")
        return read_json(root, reference.path)
