(() => {
  const root = document.getElementById("app");
  if (!root) return;

  const PAGE_SIZE = 50;

  const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  })[char]);

  const displayValue = (value) => {
    if (value === null || value === undefined) return "—";
    if (typeof value === "object") return JSON.stringify(value);
    return String(value);
  };

  async function request(url, options) {
    const response = await fetch(url, options);
    if (!response.ok) {
      let message = response.statusText;
      try {
        const body = await response.json();
        message = body.detail || message;
      } catch (_) {
        // Keep the status text when the response is not JSON.
      }
      throw new Error(message);
    }
    return response.json();
  }

  function formatDate(value) {
    if (!value) return "—";
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? String(value) : date.toLocaleString();
  }

  function statusClass(status) {
    if (status === "success") return "status status-success";
    if (status === "failed") return "status status-failed";
    return "status";
  }

  function metricMarkup(label, value) {
    return "<article class='metric'><span>" + escapeHtml(label) +
      "</span><strong>" + escapeHtml(displayValue(value)) + "</strong></article>";
  }

  function renderMetrics(reportKind, summary) {
    let metrics;
    switch (reportKind) {
      case "analysis":
        metrics = [
          ["Items", summary.item_count],
          ["Threshold", summary.threshold],
          ["Total", summary.total]
        ];
        break;
      case "comparison":
        metrics = [
          ["Items", summary.item_count],
          ["Left total", summary.left_total],
          ["Right total", summary.right_total],
          ["Difference", Number(summary.right_total || 0) - Number(summary.left_total || 0)]
        ];
        break;
      default:
        metrics = Object.entries(summary || {}).map(([key, value]) => [key, value]);
    }
    return "<div class='metrics'>" + metrics.map(([label, value]) =>
      metricMarkup(label, value)
    ).join("") + "</div>";
  }

  function renderHistory(group, businessId, groupId, currentPage) {
    const items = group.runs.map((run) => {
      const runLabel = escapeHtml(run.run_id);
      const reportUrl = "/businesses/" + encodeURIComponent(businessId) +
        "/groups/" + encodeURIComponent(groupId) + "/runs/" + encodeURIComponent(run.run_id);
      const runUrl = "/api/businesses/" + encodeURIComponent(businessId) +
        "/groups/" + encodeURIComponent(groupId) + "/runs/" + encodeURIComponent(run.run_id);
      const title = run.has_report
        ? "<a href='" + reportUrl + "'>" + runLabel + "</a>"
        : "<a href='" + runUrl + "' target='_blank' rel='noopener'>" + runLabel + "</a>";
      const error = run.error
        ? "<p class='error history-error'>" + escapeHtml(run.error) + "</p>"
        : "";
      return "<li class='history-item'><div class='history-main'><div>" + title +
        "<span class='" + statusClass(run.status) + "'>" + escapeHtml(run.status) +
        "</span></div><p class='muted'>" + escapeHtml(formatDate(run.started_at)) +
        " · " + escapeHtml(run.command) + "</p>" + error + "</div>" +
        "<span class='history-count'>" + escapeHtml(run.report_kind || "report") + "</span></li>";
    }).join("");

    const pageCount = group.history_total_pages || 0;
    const controls = pageCount > 1
      ? "<div class='pagination'><button type='button' data-history-page='" +
        (currentPage - 1) + "'" + (currentPage <= 1 ? " disabled" : "") +
        ">Previous</button><span>Page " + currentPage + " of " + pageCount +
        "</span><button type='button' data-history-page='" + (currentPage + 1) +
        "'" + (currentPage >= pageCount ? " disabled" : "") + ">Next</button></div>"
      : "";
    return "<section class='panel'><div class='section-heading'><div><h2>Run history</h2>" +
      "<p class='muted'>" + group.runs_count + " executions</p></div></div>" +
      (items ? "<ol class='history-list'>" + items + "</ol>" : "<p class='muted'>No Run history.</p>") +
      controls + "</section>";
  }

  function renderRunMetadata(run) {
    const config = JSON.stringify(run.configuration || {}, null, 2);
    const environment = JSON.stringify(run.environment || {}, null, 2);
    return "<section class='panel'><h2>Run details</h2><div class='metadata-grid'>" +
      "<div><span class='muted'>Command</span><strong>" + escapeHtml(run.command) + "</strong></div>" +
      "<div><span class='muted'>Started</span><strong>" + escapeHtml(formatDate(run.started_at)) + "</strong></div>" +
      "<div><span class='muted'>Finished</span><strong>" + escapeHtml(formatDate(run.finished_at)) + "</strong></div>" +
      "<div><span class='muted'>Status</span><strong>" + escapeHtml(run.status) + "</strong></div>" +
      "</div><details><summary>Effective configuration (secrets redacted)</summary><pre>" +
      escapeHtml(config) + "</pre></details><details><summary>Execution environment</summary><pre>" +
      escapeHtml(environment) + "</pre></details></section>";
  }

  function renderRecordRows(section, result, ref, base, runId) {
    const columns = result.columns || [];
    const rows = (result.records || []).map((record) =>
      "<tr>" + columns.map((column) =>
        "<td>" + escapeHtml(displayValue(record[column])) + "</td>"
      ).join("") + "</tr>"
    ).join("");
    const start = result.total_records === 0 ? 0 : (result.page - 1) * result.page_size + 1;
    const end = Math.min(result.page * result.page_size, result.total_records);
    section.innerHTML = "<div class='section-heading'><div><h2>" +
      escapeHtml(ref.title) + "</h2><p class='muted'>Showing " + start + "–" + end +
      " of " + result.total_records + " records</p></div></div>" +
      (columns.length
        ? "<div class='table-wrap'><table><thead><tr>" +
          columns.map((column) => "<th>" + escapeHtml(column) + "</th>").join("") +
          "</tr></thead><tbody>" + rows + "</tbody></table></div>"
        : "<p class='muted'>This Dataset contains no records.</p>") +
      "<div class='pagination'><button type='button' data-dataset-page='" +
      (result.page - 1) + "'" + (result.page <= 1 ? " disabled" : "") +
      ">Previous</button><span>Page " + result.page + " of " + result.total_pages +
      "</span><button type='button' data-dataset-page='" + (result.page + 1) +
      "'" + (result.page >= result.total_pages ? " disabled" : "") + ">Next</button></div>";

    section.querySelectorAll("[data-dataset-page]").forEach((button) => {
      button.addEventListener("click", async () => {
        const page = Number(button.dataset.datasetPage);
        if (page < 1 || page > result.total_pages) return;
        button.disabled = true;
        try {
          const next = await request(base + "/datasets/" + encodeURIComponent(ref.id) +
            "?run_id=" + encodeURIComponent(runId) + "&page=" + page +
            "&page_size=" + PAGE_SIZE);
          renderRecordRows(section, next, ref, base, runId);
        } catch (error) {
          section.insertAdjacentHTML("beforeend",
            "<p class='error'>" + escapeHtml(error.message) + "</p>");
        }
      });
    });
  }

  async function renderDataset(ref, base, runId) {
    const url = base + "/datasets/" + encodeURIComponent(ref.id) +
      "?run_id=" + encodeURIComponent(runId) + "&page=1&page_size=" + PAGE_SIZE;
    const result = await request(url);
    const section = document.createElement("section");
    section.className = "panel dataset-panel";

    if (Array.isArray(result.records)) {
      renderRecordRows(section, result, ref, base, runId);
    } else {
      section.innerHTML = "<h2>" + escapeHtml(ref.title) + "</h2><pre>" +
        escapeHtml(JSON.stringify(result.data, null, 2)) + "</pre>";
    }
    return section;
  }

  async function renderHome() {
    const businesses = await request("/api/businesses");
    root.innerHTML = "<div class='page-heading'><p class='eyebrow'>LOCAL DATA WORKSPACE</p>" +
      "<h1>Reports</h1><p class='muted'>Browse analysis results by Business, Group and Run.</p></div>";

    businesses.forEach((business) => {
      const section = document.createElement("section");
      section.className = "business panel";
      const groups = business.groups.map((group) => {
        const status = "<span class='" + statusClass(group.latest_status) + "'>" +
          escapeHtml(group.latest_status) + "</span>";
        const href = group.latest_run_id
          ? "/businesses/" + encodeURIComponent(business.business_id) +
            "/groups/" + encodeURIComponent(group.group_id)
          : null;
        const title = href
          ? "<a class='group-title' href='" + href + "'>" + escapeHtml(group.label) + "</a>"
          : "<span class='group-title'>" + escapeHtml(group.label) + "</span>";
        return "<article class='group-card'><div>" + title + status + "</div>" +
          "<p class='muted'>" + group.runs_count + " Runs · Last attempt " +
          escapeHtml(formatDate(group.latest_attempt_at)) + "</p>" +
          (group.latest_error ? "<p class='error'>" + escapeHtml(group.latest_error) + "</p>" : "") +
          "</article>";
      }).join("");

      section.innerHTML = "<div class='section-heading'><div><p class='eyebrow'>BUSINESS</p>" +
        "<h2>" + escapeHtml(business.name) + "</h2><p class='muted'>" +
        escapeHtml(business.description || "") + "</p></div><span class='muted'>" +
        business.groups.length + " Groups</span></div><div class='group-grid'>" + groups +
        "</div>";
      root.appendChild(section);
    });

    if (!businesses.length) {
      root.insertAdjacentHTML("beforeend",
        "<section class='panel empty-state'><h2>No reports yet</h2><p class='muted'>" +
        "Run an analysis command to create the first report.</p></section>");
    }
  }

  async function renderReport() {
    const businessId = root.dataset.businessId;
    const groupId = root.dataset.groupId;
    const params = new URLSearchParams(window.location.search);
    const selectedRunId = root.dataset.runId || params.get("run_id");
    const historyPage = Number(params.get("history_page") || 1);
    const base = "/api/businesses/" + encodeURIComponent(businessId) +
      "/groups/" + encodeURIComponent(groupId);
    const detailUrl = base + "?history_page=" + historyPage +
      "&history_page_size=10" +
      (selectedRunId ? "&run_id=" + encodeURIComponent(selectedRunId) : "");
    const detail = await request(detailUrl);
    const group = detail.group;
    const run = detail.latest_run;
    const reportKind = run.report_kind || root.dataset.reportKind || "generic";

    root.innerHTML = "<p class='breadcrumb'><a href='/'>All Businesses</a> / " +
      escapeHtml(detail.business.name) + " / " + escapeHtml(group.label) + "</p>" +
      "<div class='page-heading'><p class='eyebrow'>" + escapeHtml(reportKind.toUpperCase()) +
      " REPORT</p><h1>" + escapeHtml(group.label) + "</h1><p class='muted'>" +
      escapeHtml(detail.business.name) + " · Business " + escapeHtml(businessId) +
      " · Group " + escapeHtml(groupId) + "</p></div>";

    if (group.latest_status === "failed") {
      root.insertAdjacentHTML("beforeend",
        "<div class='notice notice-warning'>The latest attempt failed. Showing the most recent successful report.</div>");
    }

    const summary = document.createElement("section");
    summary.className = "panel";
    summary.innerHTML = "<div class='section-heading'><div><p class='eyebrow'>RUN SUMMARY</p>" +
      "<h2>" + escapeHtml(run.run_id) + "</h2><p class='muted'>" +
      escapeHtml(formatDate(run.started_at)) + "</p></div><span class='" +
      statusClass(run.status) + "'>" + escapeHtml(run.status) + "</span></div>" +
      renderMetrics(reportKind, run.summary || {});
    root.appendChild(summary);

    if (reportKind === "analysis") {
      root.insertAdjacentHTML("beforeend",
        "<p class='business-note'>Analysis view · records and threshold-based results</p>");
    } else if (reportKind === "comparison") {
      root.insertAdjacentHTML("beforeend",
        "<p class='business-note'>Comparison view · left and right result totals</p>");
    }

    for (const ref of run.datasets || []) {
      if (ref.id === "summary") continue;
      root.appendChild(await renderDataset(ref, base, run.run_id));
    }

    root.insertAdjacentHTML("beforeend", renderRunMetadata(run));
    root.insertAdjacentHTML("beforeend", renderHistory(group, businessId, groupId, historyPage));
    root.querySelectorAll("[data-history-page]").forEach((button) => {
      button.addEventListener("click", () => {
        const page = Number(button.dataset.historyPage);
        if (page < 1 || page > group.history_total_pages) return;
        const next = new URL(window.location.href);
        next.searchParams.set("history_page", String(page));
        window.location.href = next.toString();
      });
    });

    if (businessId === "analysis" && run.run_id === group.latest_run_id) {
      const form = document.createElement("form");
      form.className = "panel";
      form.innerHTML = "<h2>Secondary analysis</h2><p class='muted'>Run a new analysis against this Group's latest successful Dataset.</p>" +
        "<label>Minimum value <input name='threshold' type='number' min='0' value='0'></label> " +
        "<button type='submit'>Run analysis</button><p class='form-status muted' aria-live='polite'></p>";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const status = form.querySelector(".form-status");
        const threshold = Number(new FormData(form).get("threshold") || 0);
        const button = form.querySelector("button");
        button.disabled = true;
        status.textContent = "Running…";
        try {
          const result = await request(base + "/analysis", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({threshold})
          });
          status.textContent = "Created Run " + result.run_id;
          window.location.href = "/businesses/" + encodeURIComponent(businessId) +
            "/groups/" + encodeURIComponent(groupId);
        } catch (error) {
          status.textContent = error.message;
          status.className = "form-status error";
          button.disabled = false;
        }
      });
      root.appendChild(form);
    }
  }

  const render = root.dataset.page === "report" ? renderReport : renderHome;
  render().catch((error) => {
    root.innerHTML = "<section class='panel'><p class='error'>Unable to load report: " +
      escapeHtml(error.message) + "</p></section>";
  });
})();
