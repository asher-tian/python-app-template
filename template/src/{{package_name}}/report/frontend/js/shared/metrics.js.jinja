import { displayValue } from "./format.js";

export function renderMetrics(container, entries) {
  if (!Array.isArray(entries) || entries.length === 0) {
    return;
  }

  const grid = document.createElement("div");
  grid.className = "row g-3 mb-4";

  for (const [label, value] of entries) {
    const column = document.createElement("div");
    column.className = "col-12 col-sm-6 col-xl-3";

    const card = document.createElement("article");
    card.className = "card metric-card h-100";

    const body = document.createElement("div");
    body.className = "card-body";

    const caption = document.createElement("div");
    caption.className = "metric-label";
    caption.textContent = label;

    const amount = document.createElement("div");
    amount.className = "metric-value";
    amount.textContent = displayValue(value);

    body.append(caption, amount);
    card.append(body);
    column.append(card);
    grid.append(column);
  }

  container.append(grid);
}
