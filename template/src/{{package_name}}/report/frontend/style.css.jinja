:root {
  color-scheme: light;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #1f2937;
  background: #f7f8fa;
}
* { box-sizing: border-box; }
body { margin: 0; }
header {
  padding: 16px max(24px, calc((100vw - 1100px) / 2));
  background: #172033;
  color: white;
}
header a { color: white; text-decoration: none; }
main { max-width: 1100px; margin: 32px auto; padding: 0 24px 48px; }
h1 { margin: 0 0 8px; font-size: 28px; }
h2 { margin-top: 28px; font-size: 19px; }
.muted { color: #6b7280; }
.business, .panel, .group-link {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
}
.business { padding: 20px; margin: 18px 0; }
.groups { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
.group-link { display: inline-block; padding: 10px 14px; color: #1d4ed8; text-decoration: none; }
.group-link:hover { background: #eff6ff; }
.panel { padding: 18px; margin: 16px 0; overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { padding: 9px 11px; border-bottom: 1px solid #e5e7eb; text-align: left; }
th { background: #f9fafb; }
input, button { font: inherit; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 6px; }
button { cursor: pointer; background: #1d4ed8; color: white; border-color: #1d4ed8; }
pre { overflow: auto; background: #111827; color: #e5e7eb; padding: 14px; border-radius: 8px; }
.error { color: #b91c1c; }
