"""Sample analysis workflow and its Python-side secondary analysis."""

from dataclasses import dataclass


@dataclass(frozen=True)
class AnalysisInput:
    group_id: str
    label: str
    item_count: int
    threshold: int = 0


@dataclass(frozen=True)
class AnalysisResult:
    group_id: str
    label: str
    item_count: int
    threshold: int
    total: int
    records: list[dict[str, int]]


def run_analysis(request: AnalysisInput) -> AnalysisResult:
    records = [
        {"value": value, "square": value * value}
        for value in range(1, request.item_count + 1)
    ]
    return AnalysisResult(
        group_id=request.group_id,
        label=request.label,
        item_count=len(records),
        threshold=request.threshold,
        total=sum(item["square"] for item in records),
        records=records,
    )


def reanalyze_records(records: list[dict[str, int]], threshold: int) -> dict[str, int]:
    selected = [item for item in records if item["value"] >= threshold]
    return {
        "threshold": threshold,
        "selected_count": len(selected),
        "selected_total": sum(item["square"] for item in selected),
    }
