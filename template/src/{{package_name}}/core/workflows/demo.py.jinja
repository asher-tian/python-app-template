"""Pure demo workflow calculations, including chunk aggregation."""

from __future__ import annotations

from dataclasses import dataclass


@dataclass(frozen=True)
class DemoInput:
    group_id: str
    label: str
    item_count: int
    threshold: int


@dataclass(frozen=True)
class DemoChunk:
    start: int
    stop: int
    threshold: int


@dataclass(frozen=True)
class DemoChunkResult:
    records: list[dict[str, int]]
    total: int
    selected_count: int
    selected_total: int


@dataclass(frozen=True)
class DemoResult:
    group_id: str
    label: str
    item_count: int
    threshold: int
    total: int
    selected_count: int
    selected_total: int
    compute_chunks: int
    records: list[dict[str, int]]


def build_demo_chunks(request: DemoInput, *, chunk_size: int = 250) -> list[DemoChunk]:
    if chunk_size < 1:
        raise ValueError("chunk_size must be positive")
    return [
        DemoChunk(
            start=start,
            stop=min(start + chunk_size, request.item_count + 1),
            threshold=request.threshold,
        )
        for start in range(1, request.item_count + 1, chunk_size)
    ]


def calculate_demo_chunk(chunk: DemoChunk) -> DemoChunkResult:
    records = [
        {"value": value, "square": value * value}
        for value in range(chunk.start, chunk.stop)
    ]
    selected = [item for item in records if item["value"] >= chunk.threshold]
    return DemoChunkResult(
        records=records,
        total=sum(item["square"] for item in records),
        selected_count=len(selected),
        selected_total=sum(item["square"] for item in selected),
    )


def aggregate_demo(request: DemoInput, chunks: list[DemoChunkResult]) -> DemoResult:
    return DemoResult(
        group_id=request.group_id,
        label=request.label,
        item_count=sum(len(chunk.records) for chunk in chunks),
        threshold=request.threshold,
        total=sum(chunk.total for chunk in chunks),
        selected_count=sum(chunk.selected_count for chunk in chunks),
        selected_total=sum(chunk.selected_total for chunk in chunks),
        compute_chunks=len(chunks),
        records=[record for chunk in chunks for record in chunk.records],
    )


def reanalyze_records(records: list[dict[str, int]], threshold: int) -> dict[str, int]:
    selected = [item for item in records if item["value"] >= threshold]
    return {
        "threshold": threshold,
        "selected_count": len(selected),
        "selected_total": sum(item["square"] for item in selected),
    }
