"""CPU-backed analysis task."""

from {{ package_name }}.core.components.statistics import sum_squares
from {{ package_name }}.core.ports.compute import ComputeExecutor
from {{ package_name }}.core.ports.logging import Logger


class AnalysisTask:
    def __init__(self, compute: ComputeExecutor, logger: Logger) -> None:
        self._compute = compute
        self._logger = logger

    def execute(self, values: tuple[int, ...]) -> int:
        self._logger.info("Submitting CPU analysis; item_count=%d", len(values))
        result = self._compute.submit(sum_squares, values).result()
        self._logger.info("CPU analysis completed")
        return result
