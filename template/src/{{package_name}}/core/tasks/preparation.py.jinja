"""Prepare the input data for analysis."""

from {{ package_name }}.core.ports.logging import Logger


class PrepareDataTask:
    def __init__(self, logger: Logger) -> None:
        self._logger = logger

    def execute(self, item_count: int) -> tuple[int, ...]:
        self._logger.info("Preparing input data; item_count=%d", item_count)
        return tuple(range(1, item_count + 1))
