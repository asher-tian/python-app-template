"""Minimal logging capabilities used by Core and Runtime."""

from typing import Protocol


class Logger(Protocol):
    def bind(self, **context: object) -> "Logger": ...

    def debug(self, message: str, *args: object) -> None: ...

    def info(self, message: str, *args: object) -> None: ...

    def warning(self, message: str, *args: object) -> None: ...

    def error(self, message: str, *args: object) -> None: ...

    def exception(self, message: str, *args: object) -> None: ...


class LoggingContextFactory(Protocol):
    """Creates context-bound loggers and owns their output resources."""

    def run_logger(self) -> Logger: ...

    def workflow_logger(
        self,
        workflow_name: str,
        execution_id: str,
        metadata: dict[str, object] | None = None,
    ) -> Logger: ...

    def close(self) -> None: ...
