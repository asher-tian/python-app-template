"""CPU computation capability required by application workflows."""

from collections.abc import Callable
from concurrent.futures import Future
from typing import Protocol, TypeVar

T = TypeVar("T")


class ComputeExecutor(Protocol):
    def submit(
        self,
        function: Callable[..., T],
        /,
        *args: object,
        **kwargs: object,
    ) -> Future[T]:
        """Submit a serializable CPU-bound function to the shared process pool."""
        ...
