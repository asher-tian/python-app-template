"""CPU step. Only module-level workers and serializable DTOs cross process boundaries."""

import logging
from concurrent.futures import FIRST_COMPLETED, Future, wait

from {{ package_name }}.core.models import ComputeChunkInput, ComputeChunkResult
from {{ package_name }}.core.ports.compute import ComputeExecutor


def compute_chunk(payload: ComputeChunkInput) -> ComputeChunkResult:
    """Worker entry point; it must remain importable at module scope for spawn."""
    logger = logging.LoggerAdapter(
        logging.getLogger("{{ package_name }}.compute"),
        {
            "run_id": payload.run_id,
            "scope": "task",
            "task_id": payload.task_id,
            "task_label": payload.task_label,
            "step": "compute",
            "chunk_id": payload.chunk_index,
            "source": "worker",
        },
    )
    logger.debug("Chunk started; items=%d", len(payload.values))
    total = sum(value * value for value in payload.values)
    logger.debug("Chunk completed")
    return ComputeChunkResult(
        chunk_index=payload.chunk_index,
        item_count=len(payload.values),
        total=total,
    )


class ComputeStep:
    def __init__(
        self,
        compute: ComputeExecutor,
        chunk_size: int,
        max_inflight: int,
    ) -> None:
        if chunk_size < 1 or max_inflight < 1:
            raise ValueError("chunk_size and max_inflight must be positive")
        self.compute = compute
        self.chunk_size = chunk_size
        self.max_inflight = max_inflight

    def execute(
        self,
        *,
        values: tuple[int, ...],
        run_id: str,
        task_id: str,
        task_label: str,
        enabled: bool,
        logger: logging.LoggerAdapter,
    ) -> list[ComputeChunkResult]:
        if not enabled:
            logger.info("CPU step skipped")
            return []

        logger.info("CPU step started; items=%d", len(values))
        chunks = iter(
            (
                index,
                values[start : start + self.chunk_size],
            )
            for index, start in enumerate(range(0, len(values), self.chunk_size))
        )
        pending: dict[Future[ComputeChunkResult], int] = {}
        results: list[ComputeChunkResult] = []

        def submit_next() -> bool:
            try:
                chunk_index, chunk_values = next(chunks)
            except StopIteration:
                return False

            payload = ComputeChunkInput(
                run_id=run_id,
                task_id=task_id,
                task_label=task_label,
                chunk_index=chunk_index,
                values=chunk_values,
            )
            future = self.compute.submit(compute_chunk, payload)
            pending[future] = chunk_index
            return True

        for _ in range(self.max_inflight):
            if not submit_next():
                break

        while pending:
            done, _ = wait(
                pending,
                return_when=FIRST_COMPLETED,
            )
            for future in done:
                chunk_index = pending.pop(future)
                try:
                    results.append(future.result())
                except Exception:
                    for remaining in pending:
                        remaining.cancel()
                    if pending:
                        wait(pending)
                    logger.exception(
                        "CPU chunk failed; chunk=%d",
                        chunk_index,
                    )
                    raise
                submit_next()

        results.sort(key=lambda result: result.chunk_index)
        logger.info("CPU step completed; chunks=%d", len(results))
        return results
