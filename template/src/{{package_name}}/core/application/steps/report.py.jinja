"""Example HTML report renderer."""

import html

from {{ package_name }}.core.models import JsonObject


class ReportStep:
    def render(self, label: str, summary: JsonObject) -> str:
        return (
            "<!doctype html><html><head><meta charset='utf-8'>"
            f"<title>{html.escape(label)}</title></head><body>"
            f"<h1>{html.escape(label)}</h1>"
            f"<p>Items: {summary['item_count']}</p>"
            f"<p>Total: {summary['total']}</p>"
            f"<p>CPU compute enabled: {summary['compute_enabled']}</p>"
            "</body></html>"
        )
