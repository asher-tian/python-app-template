"""Atomic run manifest writer with recursive secret redaction."""

import json
import platform
import sys
from collections.abc import Mapping, Sequence
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


_SECRET_MARKERS = (
    "password",
    "passwd",
    "token",
    "secret",
    "api_key",
    "apikey",
    "access_key",
    "private_key",
    "credential",
)


def redact_secrets(value: Any) -> Any:
    if isinstance(value, dict):
        redacted: dict[str, Any] = {}
        for key, item in value.items():
            normalized = str(key).lower().replace("-", "_")
            if any(marker in normalized for marker in _SECRET_MARKERS):
                redacted[str(key)] = "[REDACTED]"
            else:
                redacted[str(key)] = redact_secrets(item)
        return redacted
    if isinstance(value, (list, tuple)):
        return [redact_secrets(item) for item in value]
    return value


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="milliseconds").replace("+00:00", "Z")


class RunManifest:
    def __init__(
        self,
        *,
        path: Path,
        run_id: str,
        command: str,
        application_name: str,
        application_version: str,
        config_source: str,
        effective_config: dict[str, Any],
    ) -> None:
        self.path = path
        self._data: dict[str, Any] = {
            "schema_version": 1,
            "run": {
                "run_id": run_id,
                "command": command,
                "started_at": utc_now(),
                "finished_at": None,
                "status": "running",
                "log_file": "run.jsonl",
            },
            "application": {
                "name": application_name,
                "version": application_version,
            },
            "configuration": {
                "source": config_source,
                "effective_config": redact_secrets(effective_config),
            },
            "environment": {
                "python_version": sys.version,
                "python_implementation": sys.implementation.name,
                "platform": platform.platform(),
                "system": platform.system(),
                "architecture": platform.machine(),
            },
            "executions": [],
        }
        self._write()

    def finish(
        self,
        outcomes: Sequence[Mapping[str, object]],
        status: str,
    ) -> None:
        executions = []
        for outcome in outcomes:
            execution_id = str(outcome["execution_id"])
            workflow_name = str(outcome["workflow_name"])
            success = bool(outcome["success"])
            item: dict[str, Any] = {
                "execution_id": execution_id,
                "workflow_name": workflow_name,
                "status": "success" if success else "failed",
                "log_file": f"workflows/{workflow_name}_{execution_id}.jsonl",
                "metadata": redact_secrets(outcome.get("metadata", {})),
            }
            error = outcome.get("error")
            if error:
                item["error"] = str(error)
            executions.append(item)

        self._data["executions"] = executions
        self._data["run"]["finished_at"] = utc_now()
        self._data["run"]["status"] = status
        self._write()

    def _write(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temporary_path = self.path.with_suffix(".json.tmp")
        temporary_path.write_text(
            json.dumps(self._data, ensure_ascii=False, indent=2, default=str) + "\n",
            encoding="utf-8",
        )
        temporary_path.replace(self.path)
