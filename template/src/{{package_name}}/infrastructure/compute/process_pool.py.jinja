"""ProcessPool and synchronous implementations of the Compute port."""

import multiprocessing as mp
from collections.abc import Callable
from concurrent.futures import Future, ProcessPoolExecutor
from typing import Any, TypeVar

from {{ package_name }}.infrastructure.logging.setup import configure_worker_logging

T = TypeVar("T")


class ProcessPoolCompute:
    def __init__(self, max_workers: int, log_queue: Any) -> None:
        if max_workers < 1:
            raise ValueError("max_workers must be positive")
        self._executor = ProcessPoolExecutor(
            max_workers=max_workers,
            mp_context=mp.get_context("spawn"),
            initializer=configure_worker_logging,
            initargs=(log_queue,),
        )
        self._closed = False

    def submit(
        self,
        function: Callable[..., T],
        /,
        *args: object,
        **kwargs: object,
    ) -> Future[T]:
        if self._closed:
            raise RuntimeError("Compute provider is closed")
        return self._executor.submit(function, *args, **kwargs)

    def close(self) -> None:
        if self._closed:
            return
        self._executor.shutdown(wait=True, cancel_futures=False)
        self._closed = True


class InlineCompute:
    """Synchronous provider for unit tests and small deterministic workloads."""

    def submit(
        self,
        function: Callable[..., T],
        /,
        *args: object,
        **kwargs: object,
    ) -> Future[T]:
        future: Future[T] = Future()
        try:
            future.set_result(function(*args, **kwargs))
        except BaseException as exc:
            future.set_exception(exc)
        return future

    def close(self) -> None:
        return None
