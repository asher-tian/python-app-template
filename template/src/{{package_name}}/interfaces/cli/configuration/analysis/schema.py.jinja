"""Pydantic schema for the Analysis CLI configuration file."""

from pathlib import Path

from pydantic import BaseModel, ConfigDict, Field


class AnalysisOptionsSchema(BaseModel):
    model_config = ConfigDict(extra="forbid")

    enable_optional_task: bool = False


class AnalysisGroupSchema(BaseModel):
    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)

    label: str = Field(min_length=1)
    item_count: int = Field(default=1000, ge=0)
    options: AnalysisOptionsSchema = Field(default_factory=AnalysisOptionsSchema)


class AnalysisConfigSchema(BaseModel):
    model_config = ConfigDict(extra="forbid")

    workpath: Path = Path("./workspace")
    groups: list[AnalysisGroupSchema] = Field(min_length=1)
