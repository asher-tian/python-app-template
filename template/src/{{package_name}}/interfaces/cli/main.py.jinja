"""CLI entry point."""

import logging
from collections.abc import Sequence

from {{ package_name }}.interfaces.cli.commands.analysis import AnalysisCommand
from {{ package_name }}.interfaces.cli.parser import build_parser


def main(argv: Sequence[str] | None = None) -> int:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
    )
    logger = logging.getLogger("{{ package_name }}.cli")
    args = build_parser().parse_args(argv)

    try:
        if args.command == "analysis":
            return AnalysisCommand().execute(args.config, dry_run=args.dry_run)
        logger.error("Unsupported command: %s", args.command)
        return 2
    except Exception as exc:
        logger.error("Command failed: %s", exc)
        return 2
