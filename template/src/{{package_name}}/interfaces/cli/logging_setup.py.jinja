"""CLI-specific Run Directory and Console + JSONL logging policy."""

from datetime import datetime
from pathlib import Path

from {{ package_name }}.infrastructure.logging.handlers import LogRouterHandler
from {{ package_name }}.infrastructure.logging.manager import LoggingManager


def create_run_directory(workpath: Path, command: str, run_id: str) -> Path:
    now = datetime.now().astimezone()
    date_part = now.strftime("%Y-%m-%d")
    time_part = now.strftime("%H-%M-%S-%f")[:-3]
    run_dir = workpath / "logs" / command / date_part / f"{time_part}_{run_id}"
    run_dir.mkdir(parents=True, exist_ok=False)
    return run_dir


def create_cli_logging_manager(
    *,
    logger_name: str,
    run_dir: Path,
    command: str,
    run_id: str,
) -> LoggingManager:
    run_dir.mkdir(parents=True, exist_ok=True)
    return LoggingManager(
        logger_name=logger_name,
        command=command,
        run_id=run_id,
        handler=LogRouterHandler(run_dir),
    )
