"""argparse command definitions."""

import argparse
from pathlib import Path


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="{{ project_slug }}")
    parser.add_argument("--version", action="version", version="%(prog)s 0.3.0")
    commands = parser.add_subparsers(dest="command", required=True)

    demo = commands.add_parser("demo", help="Run the end-to-end template demonstration")
    demo.add_argument(
        "--config",
        type=Path,
        default=Path("examples/demo.cfg"),
        help="Demo business TOML config",
    )
    demo.add_argument(
        "--app-config",
        type=Path,
        default=Path("examples/app.cfg"),
        help="Global application TOML config",
    )
    demo.add_argument("--workpath", type=Path, help="Override configured workpath")

    http = commands.add_parser("http", help="Serve reports from the configured workpath")
    http.add_argument(
        "-cfg",
        "--config",
        dest="config",
        type=Path,
        default=Path("examples/app.cfg"),
        help="Global application TOML config",
    )
    http.add_argument("--workpath", type=Path, help="Override configured workpath")
    http.add_argument("--host", help="Override HTTP bind host (loopback only)")
    http.add_argument("--port", type=int, help="Override HTTP port")
    http.add_argument("--no-open", action="store_true", help="Do not open a browser")
    return parser
