"""CLI entry point with explicit command dispatch."""

from __future__ import annotations

import logging
from collections.abc import Sequence

from {{ package_name }}.cli.commands import COMMAND_HANDLERS
from {{ package_name }}.cli.parser import build_parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")

    try:
        return COMMAND_HANDLERS[args.command](args)
    except Exception as exc:
        logging.getLogger("{{ package_name }}").error(
            "Command failed: %s: %s", type(exc).__name__, exc
        )
        return 2
