"""Start the optional local report HTTP server."""

from __future__ import annotations

import ipaddress
import logging
import threading
import webbrowser

import uvicorn

from {{ package_name }}.cli.config import load_app_config
from {{ package_name }}.http.app import create_app


def _require_loopback(host: str) -> str:
    if host == "localhost":
        return "127.0.0.1"
    try:
        address = ipaddress.ip_address(host)
    except ValueError as exc:
        raise ValueError("HTTP host must be localhost or a loopback IP address") from exc
    if not address.is_loopback:
        raise ValueError("HTTP server is restricted to loopback addresses")
    if address.version == 6:
        return f"[{address.compressed}]"
    return address.compressed


def execute(
    config_path: Path,
    *,
    workpath: Path | None = None,
    host: str | None = None,
    port: int | None = None,
    open_browser: bool = True,
) -> int:
    config = load_app_config(config_path)
    selected_host = host or config.http.host
    selected_port = config.http.port if port is None else port
    selected_workpath = workpath.expanduser().resolve() if workpath else config.app.workpath
    url_host = _require_loopback(selected_host)
    if not 1 <= selected_port <= 65535:
        raise ValueError("HTTP port must be between 1 and 65535")

    url = f"http://{url_host}:{selected_port}/"
    should_open = open_browser and config.http.auto_open
    if should_open:
        threading.Timer(1.0, webbrowser.open, args=(url,)).start()

    logging.getLogger("{{ package_name }}").info(
        "Serving workspace %s at %s", selected_workpath, url
    )
    uvicorn.run(
        create_app(
            selected_workpath,
            run_records_dir=config.workspace.run_records_dir,
        ),
        host=selected_host,
        port=selected_port,
        log_level="info",
    )
    return 0
