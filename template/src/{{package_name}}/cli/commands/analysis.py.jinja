"""CLI command for the sample Analysis business."""

from pathlib import Path

from {{ package_name }}.cli.commands.common import execute_business
from {{ package_name }}.cli.config import GroupConfig, group_id_for
from {{ package_name }}.core.workflows.analysis import AnalysisInput, run_analysis
from {{ package_name }}.report.builders import build_analysis_report


def execute(
    config_path: Path,
    app_config_path: Path,
    workpath_override: Path | None = None,
) -> int:
    def workflow(group: GroupConfig, group_id: str):
        return run_analysis(
            AnalysisInput(
                group_id=group_id,
                label=group.label,
                item_count=group.item_count,
                threshold=group.threshold,
            )
        )

    return execute_business(
        command="analysis",
        expected_business_id="analysis",
        config_path=config_path,
        app_config_path=app_config_path,
        workpath_override=workpath_override,
        workflow=workflow,
        report_builder=build_analysis_report,
        group_manifest_path=lambda group_id: f"_metadata/groups/{group_id}.json",
    )
