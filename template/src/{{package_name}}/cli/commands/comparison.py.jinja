"""CLI command for the sample Comparison business."""

from pathlib import Path

from {{ package_name }}.cli.commands.common import execute_business
from {{ package_name }}.cli.config import GroupConfig
from {{ package_name }}.core.workflows.comparison import ComparisonInput, run_comparison
from {{ package_name }}.report.builders import build_comparison_report


def execute(
    config_path: Path,
    app_config_path: Path,
    workpath_override: Path | None = None,
) -> int:
    def workflow(group: GroupConfig, group_id: str):
        return run_comparison(
            ComparisonInput(
                group_id=group_id,
                label=group.label,
                item_count=group.item_count,
                threshold=group.threshold,
            )
        )

    return execute_business(
        command="comparison",
        expected_business_id="comparison",
        config_path=config_path,
        app_config_path=app_config_path,
        workpath_override=workpath_override,
        workflow=workflow,
        report_builder=build_comparison_report,
    )
