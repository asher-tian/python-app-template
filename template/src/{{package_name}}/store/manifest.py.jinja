"""Run manifest with environment, redacted configuration and outcomes."""

from __future__ import annotations

import platform
import sys
from collections.abc import Mapping, Sequence
from datetime import UTC, datetime
from typing import Any

from {{ package_name }}.store.files import write_json
from {{ package_name }}.store.workspace import Workspace


_SECRET_MARKERS = (
    "password",
    "passwd",
    "token",
    "secret",
    "api_key",
    "apikey",
    "access_key",
    "private_key",
    "credential",
)


def redact_secrets(value: Any) -> Any:
    if isinstance(value, dict):
        return {
            str(key): (
                "[REDACTED]"
                if any(
                    marker in str(key).lower().replace("-", "_")
                    for marker in _SECRET_MARKERS
                )
                else redact_secrets(item)
            )
            for key, item in value.items()
        }
    if isinstance(value, (list, tuple)):
        return [redact_secrets(item) for item in value]
    return value


class RunManifest:
    def __init__(
        self,
        workspace: Workspace,
        *,
        run_id: str,
        command: str,
        business_id: str | None,
        config_source: str,
        effective_config: dict[str, Any],
    ) -> None:
        self.workspace = workspace
        self.run_id = run_id
        self.path = f"runs/{run_id}/manifest.json"
        self.data: dict[str, Any] = {
            "schema_version": 1,
            "run": {
                "run_id": run_id,
                "command": command,
                "business_id": business_id,
                "started_at": datetime.now(UTC).isoformat(),
                "finished_at": None,
                "status": "running",
            },
            "configuration": {
                "source": config_source,
                "effective_config": redact_secrets(effective_config),
            },
            "environment": {
                "python_version": sys.version,
                "python_implementation": sys.implementation.name,
                "platform": platform.platform(),
                "system": platform.system(),
                "architecture": platform.machine(),
            },
            "groups": [],
            "error": None,
        }
        self._write()

    def finish(
        self,
        outcomes: Sequence[Mapping[str, object]],
        status: str,
        *,
        error: str | None = None,
    ) -> None:
        self.data["groups"] = redact_secrets(list(outcomes))
        self.data["run"]["finished_at"] = datetime.now(UTC).isoformat()
        self.data["run"]["status"] = status
        self.data["error"] = error
        self._write()

    def _write(self) -> None:
        write_json(self.workspace.app_dir, self.path, self.data)
