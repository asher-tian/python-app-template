"""Safe, atomic file operations rooted in an explicit directory."""

from __future__ import annotations

import json
import uuid
from pathlib import Path, PurePosixPath
from typing import Any


def resolve_relative(root: Path, relative_path: str) -> Path:
    if not isinstance(relative_path, str) or not relative_path:
        raise ValueError("A non-empty relative path is required")
    relative = PurePosixPath(relative_path)
    if (
        relative.is_absolute()
        or not relative.parts
        or ".." in relative.parts
        or "\\" in relative_path
        or ":" in relative.parts[0]
    ):
        raise ValueError("Path must be a safe POSIX relative path")

    resolved_root = root.resolve()
    target = (resolved_root / Path(*relative.parts)).resolve()
    try:
        target.relative_to(resolved_root)
    except ValueError as exc:
        raise ValueError("Resolved path escapes its allowed root") from exc
    if target == resolved_root:
        raise ValueError("A file path cannot refer to the root directory")
    return target


def read_json(root: Path, relative_path: str) -> Any:
    path = resolve_relative(root, relative_path)
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(root: Path, relative_path: str, value: Any) -> str:
    path = resolve_relative(root, relative_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    temporary.write_text(
        json.dumps(value, ensure_ascii=False, indent=2, default=str) + "\n",
        encoding="utf-8",
    )
    temporary.replace(path)
    return PurePosixPath(relative_path).as_posix()


def write_jsonl(root: Path, relative_path: str, records: list[dict[str, Any]]) -> str:
    """Write records as newline-delimited JSON using an atomic replacement."""
    path = resolve_relative(root, relative_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    try:
        with temporary.open("w", encoding="utf-8", newline="\n") as stream:
            for record in records:
                stream.write(
                    json.dumps(record, ensure_ascii=False, separators=(",", ":"), default=str)
                )
                stream.write("\n")
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)
    return PurePosixPath(relative_path).as_posix()


def read_jsonl(root: Path, relative_path: str) -> list[dict[str, Any]]:
    path = resolve_relative(root, relative_path)
    records: list[dict[str, Any]] = []
    with path.open("r", encoding="utf-8") as stream:
        for line_number, line in enumerate(stream, start=1):
            if not line.strip():
                continue
            value = json.loads(line)
            if not isinstance(value, dict):
                raise ValueError(f"JSONL record at line {line_number} must be an object")
            records.append(value)
    return records


def read_jsonl_page(
    root: Path,
    relative_path: str,
    *,
    page: int,
    page_size: int,
    row_count: int | None = None,
) -> tuple[list[dict[str, Any]], int]:
    """Read one JSONL page without loading the complete Dataset into memory."""
    if page < 1 or page_size < 1:
        raise ValueError("Page and page size must be positive")
    path = resolve_relative(root, relative_path)
    if not path.is_file():
        raise FileNotFoundError(f"Dataset file does not exist: {relative_path}")

    if row_count is None:
        with path.open("r", encoding="utf-8") as stream:
            total = sum(1 for line in stream if line.strip())
    else:
        total = row_count

    start = (page - 1) * page_size
    stop = start + page_size
    records: list[dict[str, Any]] = []
    with path.open("r", encoding="utf-8") as stream:
        for line_number, line in enumerate(stream):
            if line_number < start:
                continue
            if line_number >= stop:
                break
            if not line.strip():
                continue
            value = json.loads(line)
            if not isinstance(value, dict):
                raise ValueError(f"JSONL record at line {line_number + 1} must be an object")
            records.append(value)
    return records, total


def write_text(root: Path, relative_path: str, content: str) -> str:
    path = resolve_relative(root, relative_path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    temporary.write_text(content, encoding="utf-8")
    temporary.replace(path)
    return PurePosixPath(relative_path).as_posix()
