"""Composition root for shared runtime resources and the demo workflow."""

from pathlib import Path

from {{ package_name }}.core.ports.logging import Logger
from {{ package_name }}.core.tasks.analysis import AnalysisTask
from {{ package_name }}.core.tasks.optional import OptionalAnalysisTask
from {{ package_name }}.core.tasks.preparation import PrepareDataTask
from {{ package_name }}.core.tasks.reporting import ReportTask
from {{ package_name }}.core.workflows.analysis.workflow import AnalysisWorkflow
from {{ package_name }}.infrastructure.execution.process_pool import ProcessPoolCompute
from {{ package_name }}.infrastructure.logging.manager import (
    LoggingManager,
    create_run_directory,
)
from {{ package_name }}.infrastructure.manifest import RunManifest
from {{ package_name }}.infrastructure.storage.local import LocalArtifactStore
from {{ package_name }}.runtime.application_runtime import ApplicationRuntime
from {{ package_name }}.runtime.workflow_runner import WorkflowRunner


def create_runtime(
    *,
    workpath: Path,
    command: str,
    run_id: str,
    run_dir: Path,
    config_source: str,
    effective_config: dict[str, object],
) -> ApplicationRuntime:
    logging_manager = LoggingManager(
        logger_name="{{ package_name }}",
        run_dir=run_dir,
        command=command,
        run_id=run_id,
    )
    compute = None
    workflow_runner = None
    try:
        compute = ProcessPoolCompute()
        storage = LocalArtifactStore(workpath)
        workflow_runner = WorkflowRunner(
            run_logger=logging_manager.run_logger(),
            workflow_logger_factory=logging_manager.workflow_logger,
        )
        manifest = RunManifest(
            path=run_dir / "manifest.json",
            run_id=run_id,
            command=command,
            application_name="{{ project_name }}",
            application_version="0.1.0",
            config_source=config_source,
            effective_config=effective_config,
        )
        return ApplicationRuntime(
            workflow_runner=workflow_runner,
            compute=compute,
            storage=storage,
            logging=logging_manager,
            manifest=manifest,
        )
    except Exception:
        if workflow_runner is not None:
            workflow_runner.close()
        if compute is not None:
            compute.close()
        logging_manager.close()
        raise


def create_analysis_workflow(runtime: ApplicationRuntime, logger: Logger) -> AnalysisWorkflow:
    """Create fresh Task instances for one Workflow execution."""
    return AnalysisWorkflow(
        prepare_task=PrepareDataTask(logger.bind(task_name="prepare_data")),
        analysis_task=AnalysisTask(
            runtime.compute,
            logger.bind(task_name="analysis"),
        ),
        optional_task=OptionalAnalysisTask(
            logger.bind(task_name="optional_analysis"),
        ),
        report_task=ReportTask(
            runtime.storage,
            logger.bind(task_name="report"),
        ),
        logger=logger,
    )


__all__ = ["create_analysis_workflow", "create_run_directory", "create_runtime"]
