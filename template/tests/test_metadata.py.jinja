import json

from {{ package_name }}.report.catalog import ReportCatalog
from {{ package_name }}.report.metadata import record_group_run
from {{ package_name }}.report.models import (
    DatasetReference,
    GroupManifest,
    ReportReference,
    RunRecord,
)
from {{ package_name }}.store.workspace import Workspace


def _run(run_id: str, status: str = "success") -> RunRecord:
    report = None
    datasets = []
    if status == "success":
        report = ReportReference(entry=f"custom/report/{run_id}/index.html")
        datasets = [
            DatasetReference(
                id="summary",
                title="Summary",
                path=f"custom/data/{run_id}.json",
            )
        ]
    return RunRecord(
        run_id=run_id,
        created_at="2026-01-01T00:00:00Z",
        status=status,
        report=report,
        datasets=datasets,
    )


def test_business_manifest_declares_custom_group_manifest_paths_and_same_label_isolated(tmp_path):
    workspace = Workspace(tmp_path / "work")
    workspace.initialize()

    for business_id in ("analysis", "comparison"):
        record_group_run(
            workspace=workspace,
            business_id=business_id,
            business_name=business_id.title(),
            business_description="",
            group_id="alpha",
            group_label="Alpha",
            group_manifest_path=f"metadata/{business_id}-groups/alpha.json",
            run=_run("run-1"),
        )

    catalog = ReportCatalog(workspace)
    businesses = catalog.list_businesses()
    assert [item.business_id for item in businesses] == ["analysis", "comparison"]
    _, _, reference, group = catalog.group_context("analysis", "alpha")
    assert reference.manifest == "metadata/analysis-groups/alpha.json"
    assert group.latest_run_id == "run-1"
    assert catalog.group_context("comparison", "alpha")[3].business_id == "comparison"


def test_failed_run_does_not_replace_latest_success(tmp_path):
    workspace = Workspace(tmp_path / "work")
    workspace.initialize()
    common = {
        "workspace": workspace,
        "business_id": "analysis",
        "business_name": "Analysis",
        "business_description": "",
        "group_id": "alpha",
        "group_label": "Alpha",
        "group_manifest_path": "_meta/alpha.json",
    }
    record_group_run(**common, run=_run("run-1"))
    record_group_run(**common, run=_run("run-2", status="failed"))

    data = json.loads(
        (workspace.business_dir("analysis") / "_meta/alpha.json").read_text(encoding="utf-8")
    )
    group = GroupManifest.model_validate(data)
    assert group.latest_run_id == "run-1"
    assert [item.run_id for item in group.runs] == ["run-1", "run-2"]
