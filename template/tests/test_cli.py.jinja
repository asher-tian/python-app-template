import pytest

from {{ package_name }}.cli.commands import COMMAND_HANDLERS
from {{ package_name }}.cli.parser import build_parser


def test_only_demo_and_http_commands_are_registered():
    assert set(COMMAND_HANDLERS) == {"demo", "http"}


def test_demo_command_uses_example_configs_by_default():
    args = build_parser().parse_args(["demo"])
    assert args.command == "demo"
    assert str(args.config) == "examples/demo.cfg"
    assert str(args.app_config) == "examples/app.cfg"


def test_demo_accepts_config_and_workpath_overrides():
    args = build_parser().parse_args([
        "demo",
        "--config",
        "custom/demo.cfg",
        "--app-config",
        "custom/app.cfg",
        "--workpath",
        "./tmp-workspace",
    ])
    assert str(args.config) == "custom/demo.cfg"
    assert str(args.app_config) == "custom/app.cfg"
    assert str(args.workpath) == "tmp-workspace"


def test_http_accepts_cfg_alias_and_no_open():
    args = build_parser().parse_args(["http", "-cfg", "custom/app.cfg", "--no-open"])
    assert args.command == "http"
    assert str(args.config) == "custom/app.cfg"
    assert args.no_open is True


def test_removed_business_commands_are_not_available():
    with pytest.raises(SystemExit):
        build_parser().parse_args(["analysis"])
    with pytest.raises(SystemExit):
        build_parser().parse_args(["comparison"])
