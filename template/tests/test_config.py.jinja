import pytest

from {{ package_name }}.cli.config import group_id_for, load_app_config, load_business_config


def test_app_config_resolves_workpath_relative_to_config_file(tmp_path):
    config_path = tmp_path / "app.cfg"
    config_path.write_text('[app]\nworkpath = "./workspace"\n', encoding="utf-8")
    config = load_app_config(config_path)
    assert config.app.workpath == (tmp_path / "workspace").resolve()


def test_business_config_derives_safe_group_ids_and_rejects_collisions(tmp_path):
    config_path = tmp_path / "analysis.cfg"
    config_path.write_text(
        '[business]\nid = "analysis"\nname = "Analysis"\n'
        '[[groups]]\nlabel = "Alpha Group"\n'
        '[[groups]]\nlabel = "Beta"\n',
        encoding="utf-8",
    )
    config = load_business_config(config_path)
    assert group_id_for(config.groups[0]) == "alpha-group"

    config_path.write_text(
        '[business]\nid = "analysis"\nname = "Analysis"\n'
        '[[groups]]\nlabel = "Alpha Group"\n'
        '[[groups]]\nlabel = "alpha-group"\n',
        encoding="utf-8",
    )
    with pytest.raises(ValueError, match="unique"):
        load_business_config(config_path)
