from {{ package_name }}.core.components.statistics import sum_squares
from {{ package_name }}.infrastructure.execution.process_pool import ProcessPoolCompute


def test_shared_process_pool_runs_module_level_serializable_function():
    compute = ProcessPoolCompute()
    try:
        result = compute.submit(sum_squares, (1, 2, 3)).result(timeout=30)
    finally:
        compute.close()

    assert result == 14
