import json

from {{ package_name }}.store.run_record import RunRecordStore, redact_secrets
from {{ package_name }}.store.workspace import Workspace


def test_run_record_stores_config_environment_and_group_outcomes(tmp_path):
    workspace = Workspace(tmp_path / "work", run_records_dir="records")
    workspace.initialize()
    run = RunRecordStore(
        workspace,
        run_id="run-1",
        command="demo",
        business_id="demo",
        business_name="Demo",
        business_description="Sample business",
        config_source="demo.cfg",
        effective_config={
            "groups": [{"label": "alpha", "api_token": "private"}],
            "password": "hidden",
        },
    )
    run.finish(
        [{"group_id": "alpha", "label": "alpha", "status": "success"}],
        "success",
    )

    data = json.loads(
        (workspace.root / "records" / "run-1" / "run.json").read_text(encoding="utf-8")
    )
    assert data["status"] == "success"
    assert data["business_id"] == "demo"
    assert data["groups"][0]["group_id"] == "alpha"
    assert data["configuration"]["effective_config"]["password"] == "[REDACTED]"
    assert (
        data["configuration"]["effective_config"]["groups"][0]["api_token"]
        == "[REDACTED]"
    )
    assert data["environment"]["python_version"]
    assert data["environment"]["platform"]
    assert not (workspace.root / "workspace.json").exists()
    assert redact_secrets({"nested": [{"secret": "x"}]}) == {
        "nested": [{"secret": "[REDACTED]"}]
    }


def test_run_record_persists_partial_group_results_while_running(tmp_path):
    workspace = Workspace(tmp_path / "work")
    run = RunRecordStore(
        workspace,
        run_id="run-2",
        command="demo",
        business_id="demo",
        business_name="Demo",
        config_source="demo.cfg",
        effective_config={"groups": []},
    )
    run.update_groups([{"group_id": "alpha", "status": "success"}])

    data = json.loads(
        (workspace.root / ".app" / "runs" / "run-2" / "run.json").read_text(
            encoding="utf-8"
        )
    )
    assert data["status"] == "running"
    assert data["groups"] == [{"group_id": "alpha", "status": "success"}]
