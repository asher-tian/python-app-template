from concurrent.futures import Future

from {{ package_name }}.core.ports.logging import Logger
from {{ package_name }}.core.tasks.analysis import AnalysisTask
from {{ package_name }}.core.tasks.optional import OptionalAnalysisTask
from {{ package_name }}.core.tasks.preparation import PrepareDataTask
from {{ package_name }}.core.tasks.reporting import ReportTask
from {{ package_name }}.core.workflows.analysis.models import (
    AnalysisOptions,
    AnalysisWorkflowInput,
)
from {{ package_name }}.core.workflows.analysis.workflow import AnalysisWorkflow


class FakeLogger:
    def bind(self, **context: object) -> "FakeLogger":
        return self

    def debug(self, message: str, *args: object) -> None:
        pass

    def info(self, message: str, *args: object) -> None:
        pass

    def warning(self, message: str, *args: object) -> None:
        pass

    def error(self, message: str, *args: object) -> None:
        pass

    def exception(self, message: str, *args: object) -> None:
        pass


class FakeCompute:
    def submit(self, function, /, *args, **kwargs):
        future = Future()
        try:
            future.set_result(function(*args, **kwargs))
        except Exception as exc:
            future.set_exception(exc)
        return future


class FakeStorage:
    def __init__(self) -> None:
        self.files: dict[str, str] = {}

    def write_text(self, key: str, content: str) -> str:
        self.files[key] = content
        return key


def build_workflow(storage: FakeStorage) -> AnalysisWorkflow:
    logger: Logger = FakeLogger()
    return AnalysisWorkflow(
        prepare_task=PrepareDataTask(logger),
        analysis_task=AnalysisTask(FakeCompute(), logger),
        optional_task=OptionalAnalysisTask(logger),
        report_task=ReportTask(storage, logger),
        logger=logger,
    )


def test_workflow_runs_optional_task_when_enabled():
    storage = FakeStorage()
    workflow = build_workflow(storage)

    result = workflow.execute(
        AnalysisWorkflowInput(
            label="alpha",
            item_count=3,
            output_key="reports/alpha/index.html",
            options=AnalysisOptions(enable_optional_task=True),
        )
    )

    assert result.total == 14
    assert result.optional_value == 3
    assert result.report_key in storage.files
    assert "Optional result: 3" in storage.files[result.report_key]


def test_workflow_skips_optional_task_when_disabled():
    storage = FakeStorage()
    workflow = build_workflow(storage)

    result = workflow.execute(
        AnalysisWorkflowInput(
            label="beta",
            item_count=2,
            output_key="reports/beta/index.html",
            options=AnalysisOptions(),
        )
    )

    assert result.total == 5
    assert result.optional_value is None
    assert "Optional analysis was not enabled" in storage.files[result.report_key]
