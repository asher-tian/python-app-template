import json

import pytest

from {{ package_name }}.infrastructure.database.sqlite import (
    SQLiteTaskResultRepository,
)
from {{ package_name }}.infrastructure.storage.local import LocalArtifactStore


def test_local_artifact_store_writes_nested_file(tmp_path):
    store = LocalArtifactStore(tmp_path)
    key = store.write_text("reports/result.html", "<h1>ok</h1>")
    assert key == "reports/result.html"
    assert (tmp_path / key).read_text(encoding="utf-8") == "<h1>ok</h1>"


@pytest.mark.parametrize("key", ["../escape.txt", "/absolute.txt", ".", ""])
def test_local_artifact_store_rejects_unsafe_paths(tmp_path, key):
    with pytest.raises(ValueError):
        LocalArtifactStore(tmp_path).write_text(key, "unsafe")


def test_sqlite_repository_saves_result_and_closes_connections(tmp_path):
    path = tmp_path / "state.sqlite3"
    repository = SQLiteTaskResultRepository(path)
    repository.save(
        "run-1",
        "task-1",
        "example",
        {"item_count": 3, "total": 5},
    )

    import sqlite3

    with sqlite3.connect(path) as connection:
        row = connection.execute(
            "SELECT run_id, task_id, summary_json FROM task_results"
        ).fetchone()

    assert row[:2] == ("run-1", "task-1")
    assert json.loads(row[2]) == {"item_count": 3, "total": 5}
