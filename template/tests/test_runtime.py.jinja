from {{ package_name }}.interfaces.cli.logging_setup import create_cli_logging_manager
from {{ package_name }}.runtime.workflow_runner import WorkflowRunner


def test_workflow_runner_rejects_calls_after_close(tmp_path):
    logging_manager = create_cli_logging_manager(
        logger_name="test.closed_runner",
        run_dir=tmp_path / "logs",
        command="analysis",
        run_id="run-1",
    )
    runner = WorkflowRunner(
        run_logger=logging_manager.run_logger(),
        workflow_logger_factory=logging_manager.workflow_logger,
    )
    runner.close()
    logging_manager.close()

    try:
        runner.run(
            workflow_name="analysis",
            workflow_factory=lambda logger: None,
            inputs=[1],
        )
    except RuntimeError as exc:
        assert "closed" in str(exc)
    else:
        raise AssertionError("Expected a closed runner to reject execution")
