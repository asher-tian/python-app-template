import json

from {{ package_name }}.store.manifest import RunManifest, redact_secrets
from {{ package_name }}.store.workspace import Workspace


def test_run_manifest_records_environment_outcomes_and_redacts_secrets(tmp_path):
    workspace = Workspace(tmp_path / "work")
    workspace.initialize()
    run_dir = workspace.run_dir("run-1")
    run_dir.mkdir(parents=True)
    manifest = RunManifest(
        workspace,
        run_id="run-1",
        command="analysis",
        business_id="analysis",
        config_source="analysis.cfg",
        effective_config={
            "groups": [{"label": "alpha", "api_token": "private"}],
            "password": "hidden",
        },
    )
    manifest.finish(
        [{"business_id": "analysis", "group_id": "alpha", "status": "success"}],
        "success",
    )

    data = json.loads(
        (workspace.app_dir / "runs" / "run-1" / "manifest.json").read_text(encoding="utf-8")
    )
    assert data["run"]["status"] == "success"
    assert data["groups"][0]["group_id"] == "alpha"
    assert data["configuration"]["effective_config"]["password"] == "[REDACTED]"
    assert data["configuration"]["effective_config"]["groups"][0]["api_token"] == "[REDACTED]"
    assert redact_secrets({"nested": [{"secret": "x"}]}) == {
        "nested": [{"secret": "[REDACTED]"}]
    }
