import json

from {{ package_name }}.infrastructure.manifest import RunManifest


def test_manifest_records_effective_config_environment_and_execution_status(tmp_path):
    manifest = RunManifest(
        path=tmp_path / "manifest.json",
        run_id="run-1",
        command="analysis",
        application_name="Demo",
        application_version="0.1.0",
        config_source="config.json",
        effective_config={
            "workpath": "/workspace",
            "api_token": "do-not-save",
            "groups": [{"label": "alpha", "enabled": True}],
        },
    )
    manifest.finish(
        [
            {
                "execution_id": "0001",
                "workflow_name": "analysis",
                "success": True,
                "metadata": {"label": "alpha"},
            },
            {
                "execution_id": "0002",
                "workflow_name": "analysis",
                "success": False,
                "metadata": {"label": "beta"},
                "error": "ValueError: failed",
            },
        ],
        "failed",
    )

    data = json.loads((tmp_path / "manifest.json").read_text(encoding="utf-8"))
    assert data["run"]["status"] == "failed"
    assert data["run"]["finished_at"] is not None
    assert data["configuration"]["effective_config"]["api_token"] == "[REDACTED]"
    assert data["executions"][0]["log_file"] == "workflows/analysis_0001.jsonl"
    assert data["executions"][1]["status"] == "failed"
    assert data["environment"]["python_implementation"]
