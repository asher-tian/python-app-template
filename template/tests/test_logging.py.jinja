import json

from {{ package_name }}.interfaces.cli.logging_setup import create_cli_logging_manager


def test_jsonl_routes_run_and_workflow_logs_and_keeps_traceback_out_of_console(
    tmp_path,
    capsys,
):
    run_dir = tmp_path / "logs"
    manager = create_cli_logging_manager(
        logger_name="test.structured_logging",
        run_dir=run_dir,
        command="analysis",
        run_id="run-1",
    )
    run_logger = manager.run_logger()
    workflow_logger = manager.workflow_logger(
        "analysis",
        "0001",
        {"label": "alpha"},
    )

    run_logger.info("Run started")
    workflow_logger.bind(task_name="analysis").info("Task started")
    try:
        raise ValueError("invalid sample")
    except ValueError:
        workflow_logger.bind(task_name="analysis").exception("Task failed")

    manager.close()
    console = capsys.readouterr().err

    run_records = [
        json.loads(line)
        for line in (run_dir / "run.jsonl").read_text(encoding="utf-8").splitlines()
    ]
    workflow_path = run_dir / "workflows" / "analysis_0001.jsonl"
    workflow_records = [
        json.loads(line)
        for line in workflow_path.read_text(encoding="utf-8").splitlines()
    ]

    assert run_records[0]["message"] == "Run started"
    assert all(record["message"] != "Task started" for record in run_records)
    assert workflow_records[0]["execution_id"] == "0001"
    assert workflow_records[0]["metadata"] == {"label": "alpha"}
    assert workflow_records[-1]["exception"]["type"] == "ValueError"
    assert "Traceback" in workflow_records[-1]["exception"]["stacktrace"]
    assert "ValueError: invalid sample" in console
    assert "Traceback" not in console
