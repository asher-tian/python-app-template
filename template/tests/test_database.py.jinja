import json
import sqlite3

from {{ package_name }}.infrastructure.database.sqlite import SQLiteResultRepository


def test_optional_sqlite_repository_uses_short_lived_connections(tmp_path):
    path = tmp_path / "state.sqlite3"
    repository = SQLiteResultRepository(path)
    repository.save("run-1", "0001", json.dumps({"total": 14}))

    with sqlite3.connect(path) as connection:
        row = connection.execute(
            "SELECT run_id, execution_id, result_json FROM workflow_results"
        ).fetchone()

    assert row == ("run-1", "0001", '{"total": 14}')
